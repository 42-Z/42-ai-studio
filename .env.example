# Образец переменных окружения. Скопируйте файл в .env и подставьте свои значения.
# Настоящие секреты в репозиторий не попадают.

# Строка подключения к Postgres. Обязательна.
DATABASE_URL=postgres://studio:studio@localhost:55432/studio_dev

# URL S3-совместимого API. Обязательна. Доступность не проверяется, её видит /api/health.
S3_ENDPOINT=http://localhost:59000

# Регион хранилища (для MinIO-совместимых подойдёт любой). Обязательна.
S3_REGION=us-east-1

# Имя бакета. Обязательна.
S3_BUCKET=studio-dev

# Ключ доступа к хранилищу. Обязательна.
S3_ACCESS_KEY_ID=minioadmin

# Секретный ключ хранилища. Обязательна.
S3_SECRET_ACCESS_KEY=minioadmin

# true, если провайдер требует адресацию «хост/бакет/ключ» (так требует MinIO-совместимое).
# Необязательна, по умолчанию false. Допустимые значения: 1, 0, true, false.
S3_FORCE_PATH_STYLE=true

# Публичный адрес приложения без завершающего /. Обязательна.
APP_URL=http://localhost:3000

# 1 включает тестовые подмены (появятся в следующих тикетах); вместе с NODE_ENV=production запрещена.
# Необязательна. В рабочем .env держите 0; значение 1 предназначено только для .env.test.
APP_TEST_MODE=0

# Порт, на котором HTTP-тесты запускают основной экземпляр приложения.
# Необязательна, по умолчанию 3100. Дополнительные экземпляры берут порты из диапазона 3100–3199.
TEST_APP_PORT=3100

# Каталог сборки Next.js. Необязательна, по умолчанию .next.
# Тесты задают свой каталог на каждый экземпляр (.next-test-<порт>), чтобы запускать их одновременно.
NEXT_DIST_DIR=.next

# Client ID (он же Bot ID) из @BotFather, только цифры. Обязательна при NODE_ENV=production.
# Это же значение проверяется как `aud` в id_token.
TELEGRAM_CLIENT_ID=

# Client Secret из Login Widget в @BotFather, не токен бота.
# Обязателен вместе с TELEGRAM_CLIENT_ID; используется только сервером.
TELEGRAM_CLIENT_SECRET=

# Издатель OIDC. Необязательна, по умолчанию https://oauth.telegram.org.
# Discovery-документ берётся по адресу <издатель>/.well-known/openid-configuration.
# Вне production допускается http:// только вместе с APP_TEST_MODE=1.
TELEGRAM_OIDC_ISSUER=https://oauth.telegram.org

# Секрет подписи временной cookie входа OIDC, не короче 32 символов. Обязательна всегда.
# Получить свой: openssl rand -base64 48
# Значение ниже годится только для локальной разработки: в production оно отвергается.
SESSION_SECRET=dev-only-session-secret-change-me-0123456789abcd

# Срок жизни сессии входа, целое число дней от 1 до 365. Необязательна, по умолчанию 30.
SESSION_TTL_DAYS=30

# 1 включает вход без Telegram. Разрешён только на localhost, 127.0.0.1 или [::1]
# и никогда в production. Для рабочего окружения оставьте пустой или 0.
DEV_LOGIN_ENABLED=1
