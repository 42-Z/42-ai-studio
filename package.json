    "@types/node": "24.x",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.64.1",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "engines": {
    "node": "24.x"
  }
