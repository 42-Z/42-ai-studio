{
  "name": "42-ai-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "dev": "next dev",
    "dev:agent": "eve dev",
    "build": "eve build && next build",
    "build:web": "next build",
    "build:agent": "eve build",
    "start": "next start",
    "start:agent": "eve start",
    "eval": "eve eval",
    "deploy": "eve deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:http": "vitest run --config vitest.http.config.ts",
    "test:render": "vitest run --config vitest.render.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@base-ui/react": "^1.9.0",
    "@next/env": "^16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/connect": "2.5.2",
    "ai": "^7.0.137",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "drizzle-orm": "^0.45.4",
    "eve": "^0.83.0",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.32",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "4.5.4"
  },
